---
import '../styles/global.css';
import SharedNavigation from '../components/SharedNavigation.astro';

const {
  title = 'Јовица Вратница — лична прича',
  description = 'Животни пут, лична борба и идеје које претварам у дела.'
} = Astro.props;
---
<!doctype html>
<html lang="sr-Cyrl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1f3ee" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SharedNavigation />
    <slot />
  </body>
</html>
---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const sections = [
  { id: 'tri-decenije', no: '01', title: 'Три деценије промене' },
  { id: 'unutrasnji-lanac', no: '02', title: 'Борба против унутрашњег ланца' },
  { id: 'razliciti-oblici', no: '03', title: 'Борба има много облика' },
  { id: 'bitka-za-svest', no: '04', title: 'Битка за свест' },
  { id: 'aktivista-svesti', no: '05', title: 'Активиста свести' }
];
---
<BaseLayout title="Мој пут — од питања до деловања | Јовица Вратница" description="Животни пут Јовице Вратнице — од филозофских питања и неконформизма до бунта и више од три деценије друштвеног деловања.">
<header class="chapter-nav"><a href={base + 'o-meni/'}>← О МЕНИ</a><a href={base}>⌂ ПОЧЕТНА</a></header>
<main class="rebel-page">
  <section class="rebel-hero">
    <p class="kicker">МОЈА ПРИЧА · НИТ 03</p>
    <h1>МОЈ ПУТ —<br/><em>ОД ПИТАЊА ДО ДЕЛОВАЊА</em></h1>
    <p class="hero-lead">Мој пут је почео много пре него што сам изашао на улицу. Почео је питањима, преиспитивањем и потребом да пронађем сопствени однос према свету. Из тога су се развили неконформизам, бунт и више од три деценије деловања.</p>
    <div class="hero-meta"><span>ОД ЛИЧНИХ ПИТАЊА ДО ДРУШТВЕНОГ ДЕЛОВАЊА</span><span>ЛИЧНИ ПУТ · ДРУШТВЕНО ДЕЛОВАЊЕ</span></div>
  </section>

  <nav class="story-index" aria-label="Секције приче">
    <p>У ОВОЈ ПРИЧИ</p>
    {sections.map((section) => <a href={'#' + section.id}><span>{section.no}</span>{section.title}<b>↘</b></a>)}
  </nav>

  <div class="story-content">
    <section class="story-section" id="tri-decenije">
      <div class="section-number">01</div>
      <div class="section-body">
        <p class="section-kicker">ПОЧЕТАК И ТРАЈАЊЕ</p>
        <h2>Од питања до<br/><em>деловања.</em></h2>
        <p>Мој пут није почео на улици. Почео је у мени — питањима о свету, људима, правди, слободи и ономе што прихватамо као нормално.</p>
        <p>Од 1996. године та питања постепено су прерастала у разговоре, расправе, протесте, иницијативе и конкретне покушаје да се нешто промени. Мој пут није био правац без скретања, већ стално тражење начина да уверења претворим у деловање.</p>
      </div>
    </section>

    <section class="story-section" id="unutrasnji-lanac">
      <div class="section-number">02</div>
      <div class="section-body">
        <p class="section-kicker">ШТА ЈЕ БИО ПРАВИ ПРОБЛЕМ</p>
        <h2>Борба против<br/><em>унутрашњег ланца.</em></h2>
        <p>И то није била борба само против система — већ пре свега против онога што сам видео у људима: дубоко укорењен страх, скептицизам и прихватање „нормалности“ која нас држи заробљене и покорене.</p>
        <p>Одрастајући, све јасније сам видео да нас не кочи само неправедна власт, већ унутрашњи ланац који носимо у себи. Ланац који говори:</p>
        <blockquote>„Тако мора.“<br/>„Ништа не можеш да промениш.“<br/>„Ћути и трпи.“</blockquote>
      </div>
    </section>

    <section class="story-section" id="razliciti-oblici">
      <div class="section-number">03</div>
      <div class="section-body">
        <p class="section-kicker">УЛИЦА НИЈЕ БИЛА ЈЕДИНО МЕСТО</p>
        <h2>Борба има<br/><em>много облика.</em></h2>
        <p>Нису то били само политички протести и улице. То су били разговори, расправе, интернет форуми, мобилизације, подизање свести, објашњавање, мотивисање.</p>
        <p>Где год је постојала могућност да се људи пробуде, ја сам био тамо.</p>
      </div>
    </section>

    <section class="story-section" id="bitka-za-svest">
      <div class="section-number">04</div>
      <div class="section-body">
        <p class="section-kicker">НАЈВАЖНИЈА СПОЗНАЈА</p>
        <h2>Битка<br/><em>за свест.</em></h2>
        <p>Временом сам схватио да је највећа битка увек била — битка за свест.</p>
        <p>Не можемо променити спољашње структуре ако не променимо себе. Не можемо градити ново друштво ако носимо стара уверења. Не можемо се ослободити док верујемо да слобода није могућа.</p>
      </div>
    </section>

    <section class="story-section final-section" id="aktivista-svesti">
      <div class="section-number">05</div>
      <div class="section-body">
        <p class="section-kicker">ШТА ЈЕ ОСТАЛО СУШТИНА МОГ БУНТА</p>
        <h2>Активиста<br/><em>свести.</em></h2>
        <p>Посматрајући све те године, схватио сам да нисам био само активиста улице — био сам активиста свести.</p>
        <p>Борио сам се за оно што људи не виде, за оно што су заборавили у себи: веру у промену, веру у себе, веру у боље сутра.</p>
        <p class="closing-line">То је био, и остао, мој прави фронт.</p>
      </div>
    </section>
  </div>

  <footer class="rebel-footer">
    <p>ЈОВИЦА ВРАТНИЦА · МОЈ ЖИВОТНИ ПУТ</p>
    <a href={base + 'o-meni/'}>← НАЗАД НА „О МЕНИ“</a>
    <a href={base + 'junacko-srce/'}>СЛЕДЕЋА НИТ: ЈУНАЧКО СРЦЕ ↗</a>
  </footer>
</main>
<style>
.chapter-nav{display:flex;justify-content:space-between;padding:20px max(22px,calc((100vw - 1120px)/2));border-bottom:1px solid #ddd;font-size:.72rem;font-weight:850;letter-spacing:.12em}.chapter-nav a{color:inherit;text-decoration:none}
.rebel-page{color:#20232a}.rebel-hero{background:#171a20;color:#fff;padding:clamp(65px,10vw,125px) max(24px,calc((100vw - 1050px)/2)) 48px}.kicker,.section-kicker{font-size:.7rem;font-weight:850;letter-spacing:.17em;color:#ed555b}.rebel-hero h1{font-size:clamp(2.8rem,8vw,6.7rem);line-height:.94;letter-spacing:-.065em;margin:28px 0;max-width:1050px}.rebel-hero h1 em,.story-section h2 em{font-style:normal;color:#e5484d}.hero-lead{max-width:690px;font-size:clamp(1.2rem,2.8vw,1.8rem);line-height:1.5;font-weight:650;color:#e6e7e9}.hero-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:55px;padding-top:18px;border-top:1px solid #555;color:#bfc2c8;font-size:.65rem;font-weight:800;letter-spacing:.12em}
.story-index{position:relative;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;padding:28px max(24px,calc((100vw - 1050px)/2));background:#f0f1f3;border-bottom:1px solid #d9dce1}.story-index>p{grid-column:1/-1;margin:0 0 14px;color:#747982;font-size:.65rem;font-weight:850;letter-spacing:.16em}.story-index a{display:flex;flex-direction:column;gap:10px;padding:12px 14px 12px 0;color:#252932;text-decoration:none;font-size:.83rem;font-weight:800;line-height:1.3;border-right:1px solid #d4d7dc}.story-index a:not(:first-of-type){padding-left:14px}.story-index a span{color:#d83e47;font-size:.68rem}.story-index a b{font-size:1rem;color:#d83e47}
.story-content{max-width:1050px;margin:0 auto;padding:20px 24px 70px}.story-section{display:grid;grid-template-columns:90px minmax(0,760px);gap:25px;padding:75px 0;border-bottom:1px solid #e1e3e6;scroll-margin-top:25px}.section-number{font-size:1rem;font-weight:900;color:#e5484d;padding-top:8px}.section-body h2{font-size:clamp(2.3rem,5.5vw,4.6rem);letter-spacing:-.06em;line-height:.98;margin:15px 0 28px}.section-body>p:not(.section-kicker){font-size:1.08rem;line-height:1.85;color:#343943;margin:0 0 18px}.section-body blockquote{margin:28px 0 0;padding:22px 28px;border-left:4px solid #e5484d;background:#f1f2f4;font-size:clamp(1.25rem,3vw,1.8rem);font-weight:850;line-height:1.7;color:#20232a}.closing-line{font-size:clamp(1.35rem,3vw,2rem)!important;font-weight:850;color:#20232a!important;margin-top:30px!important}
.rebel-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px;padding:35px max(24px,calc((100vw - 1050px)/2));background:#171a20;color:#fff}.rebel-footer p{width:100%;margin:0;color:#aaa;font-size:.65rem;font-weight:800;letter-spacing:.13em}.rebel-footer a{color:#fff;text-decoration:none;font-size:.72rem;font-weight:850;letter-spacing:.06em}.rebel-footer a:last-child{color:#ff696e}
@media(max-width:700px){.story-index{grid-template-columns:1fr 1fr;gap:0 14px}.story-index a,.story-index a:not(:first-of-type){padding:13px 4px;border-right:0;border-bottom:1px solid #d4d7dc}.story-section{grid-template-columns:34px minmax(0,1fr);gap:12px;padding:52px 0}.section-number{font-size:.8rem}.section-body>p:not(.section-kicker){font-size:1rem}.hero-meta{margin-top:35px}.rebel-footer{flex-direction:column}}
</style>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const chapters = [
  {
    number: '01',
    period: '2000',
    label: 'ПРОМЕНЕ И РАЗОЧАРАЊЕ',
    title: 'ВЕРОВАО САМ ДА СУ ПРОМЕНЕ МОГУЋЕ.',
    text: 'Био сам међу онима који су веровали да Србији требају промене. Али оно што је уследило после демократских промена донело је и разочарање. Мој однос према неправди није зависио од тога ко је на власти.'
  },
  {
    number: '02',
    period: '2003',
    label: 'ВОЈСКА',
    title: 'ГОДИНА У ВОЈСЦИ.',
    text: 'Током 2003. године служио сам војни рок.'
  },
  {
    number: '03',
    period: 'МАРТ 2004.',
    label: 'ПРОТЕСТИ',
    title: 'ИЗАШАО САМ НА УЛИЦУ.',
    text: 'После мартовског погрома над Србима на Косову и Метохији, марта 2004. године, учествовао сам на протестима. Због учешћа сам био приведен, а касније сам добио условну казну од две године.'
  },
  {
    number: '04',
    period: '2006',
    label: 'ДВЕРИ',
    title: 'ПРИКЉУЧИО САМ СЕ ПОКРЕТУ.',
    text: 'Године 2006. прикључио сам се Дверима. У то време Двери су биле организација и покрет, а не политичка странка. Био ми је близак њихов тадашњи поглед на друштво и вредности.'
  }
];

const fieldWork = [
  {
    number: '01',
    title: 'КОСОВО И МЕТОХИЈА — НА ТЕРЕНУ',
    text: 'Од 2006. до 2010. године више пута сам путовао на Косово и Метохију. Обилазио сам српске енклаве, одлазио до Јариња, разговарао са људима и бележио свакодневни живот и услове у којима су живели.'
  },
  {
    number: '02',
    title: 'ФОТОГРАФИЈЕ КОЈЕ СВЕДОЧЕ',
    text: 'Фотографисао сам породице, децу, школе, куће, цркве и манастире, као и свакодневицу људи у енклавама. У мојој архиви остало је више од хиљаду фотографија.'
  },
  {
    number: '03',
    title: 'ХУМАНИТАРНИ РАД',
    text: 'Учествовао сам у активностима подршке Србима на Косову и Метохији. Осмислио сам и реализовао видео-спот о народним кухињама, са циљем да се јавност упозна са њиховим радом и потребама. Учествовао сам и у довођењу деце са Косова и Метохије у Београд.'
  },
  {
    number: '04',
    title: 'ИЗЛОЖБЕ „КОСОВО И МЕТОХИЈА — УЖИВО“',
    text: 'Организовао сам фото-изложбе у сарадњи са различитим групама и организацијама, међу којима су биле и локалне секције навијачке групе Делије Север. Изложбе су одржаване у Нишкој Бањи, Јагодини, Бачкој Паланци, Инђији, Црној Гори и другим местима.'
  },
  {
    number: '05',
    title: 'ПОВЕЗИВАЊЕ ЉУДИ И ОРГАНИЗАЦИЈА',
    text: 'Сарађивао сам са различитим удружењима, групама и појединцима на активностима везаним за Косово и Метохију, хуманитарни рад и подршку угроженима. Важно ми је било да се људи повежу и да добра намера добије конкретан облик.'
  }
];

const forums = ['Видовдан', 'Верујем', 'Српски националисти', 'Бурек', 'Делује.нет'];
---

<BaseLayout
  title="Активизам — шта сам до сада радио? | Јовица Вратница"
  description="Преглед грађанског, теренског, хуманитарног и интернет активизма Јовице Вратнице."
>
  <main class="activism-page">
    <section class="activism-hero">
      <div class="activism-hero-inner">
        <p class="eyebrow"><span></span> МОЈ ПУТ · МОЈЕ ДЕЛОВАЊЕ</p>
        <h1>АКТИВИЗАМ.<br /><em>ОД УЛИЦЕ ДО ИНТЕРНЕТА.</em></h1>
        <p class="hero-lead">Мој активизам никада није био везан само за једно место или један начин деловања. Мењао се облик борбе, али не и потреба да реагујем, говорим и покрећем људе.</p>
        <div class="hero-tags"><span>ТЕРЕН</span><i></i><span>ИНТЕРНЕТ</span><i></i><span>ХУМАНИТАРНИ РАД</span><i></i><span>ПОВЕЗИВАЊЕ</span></div>
      </div>
      <span class="hero-index">01 / МОЈ АКТИВИЗАМ</span>
    </section>

    <section class="timeline-section">
      <div class="section-heading">
        <p class="section-kicker">КАКО ЈЕ ПОЧЕЛО</p>
        <h2>ПУТ КОЈИ ЈЕ<br /><em>ПРЕТХОДИО ИНТЕРНЕТУ.</em></h2>
        <p>Пре него што су интернет и форуми постали важан део мог деловања, постојали су улица, протести, лична уверења и конкретни догађаји.</p>
      </div>
      <div class="timeline">
        {chapters.map((chapter) => (
          <article class="timeline-item">
            <div class="timeline-period"><span>{chapter.number}</span><b>{chapter.period}</b></div>
            <div class="timeline-copy">
              <p class="item-label">{chapter.label}</p>
              <h3>{chapter.title}</h3>
              <p>{chapter.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="field-section">
      <div class="section-heading">
        <p class="section-kicker">2006—2010 · АКТИВИЗАМ НА ТЕРЕНУ</p>
        <h2>НИСАМ САМО<br /><em>ГОВОРИО О ТОМЕ.</em></h2>
        <p>Путовао сам, разговарао са људима, бележио оно што сам видео и учествовао у активностима које су повезивале људе и конкретну помоћ.</p>
      </div>
      <div class="field-grid">
        {fieldWork.map((item) => (
          <article class="field-card">
            <span class="field-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <figure class="field-quote">
        <blockquote>„Нисам желео само да причам о ономе што се дешава. Желео сам да одем, видим, забележим и пренесем другима.“</blockquote>
        <figcaption>ТЕРЕНСКИ РАД · КОСОВО И МЕТОХИЈА</figcaption>
      </figure>
    </section>

    <section class="internet-section" id="internet">
      <div class="internet-top">
        <p class="section-kicker">ОД 2005. ГОДИНЕ · ДИГИТАЛНИ ПРОСТОР</p>
        <span class="internet-mark">02 / 04</span>
      </div>
      <div class="internet-heading">
        <p class="internet-overline">ИНТЕРНЕТ АКТИВИЗАМ</p>
        <h2>БОРБА ЗА<br /><em>НАРАТИВ.</em></h2>
        <p class="internet-lead">Интернет за мене није био само место за објављивање и разговор. Био је простор у којем се водила борба за то како ће људи разумети догађаје, проблеме и стварност.</p>
      </div>
      <div class="internet-body">
        <div class="internet-story">
          <p>Интернет сам почео да користим још 2005. године, у време када се велики део јавне комуникације на вебу одвијао на форумима. Било је мање корисника него данас, али су форуми били места на којима су се људи окупљали, размењивали искуства, расправљали и ширили знање. Један од форума на којима сам био активан био је Бурек. Наступао сам и под псеудонимом <strong>„Србин православац“</strong>, покретао теме, писао, учествовао у расправама и делио информације.</p>
          <p>Био сам активан на форумима као што су:</p>
          <div class="forum-list">
            {forums.map((forum) => <span>{forum}</span>)}
          </div>
          <p>Посебно сам писао о Косову и Метохији, животу српског народа у енклавама, хуманитарним активностима и друштвеним питањима.</p>
          <p>Временом су се начини комуникације ширили. Поред форума, друштвене мреже су ми отвориле нови простор за писање, размену мишљења и реакцију на оно што се дешава у друштву. Фејсбук сам доживљавао као место на ком могу слободно да изнесем став, покренем разговор и дам глас темама које ме тиште.</p>
        </div>
        <aside class="internet-principle">
          <span>МОЈ ПРИСТУП</span>
          <p>Када ми сервирају једну причу, не морам да је прихватим.</p>
          <p>Могу да понудим другу перспективу, аргументе, чињенице и искуство.</p>
        </aside>
      </div>
      <div class="internet-belief">
        <p class="belief-label">МОЈ ПОГЛЕД НА ИНТЕРНЕТ</p>
        <h3>ИНТЕРНЕТ ЈЕ КОМУНИКАЦИЈА.<br /><em>А КОМУНИКАЦИЈА ЈЕ ШИРЕЊЕ ЗНАЊА.</em></h3>
        <p>Разговор за мене није био празна размена речи. У њему сам видео прилику да чујем другачије искуство, поделим оно што знам и научим нешто ново. Верујем да знање и искуство добијају праву вредност када се деле.</p>
        <p>Комуникација се не завршава речима. И графички дизајн сам препознао као начин да се идеја пренесе визуелно и да порука стигне до људи.</p>
      </div>
      <div class="narrative-line">
        <span>СУШТИНА МОГ ИНТЕРНЕТ АКТИВИЗМА</span>
        <h3>НИСАМ ЖЕЛЕО САМО ДА УЧЕСТВУЈЕМ У ТУЂОЈ ПРИЧИ. <em>ЖЕЛЕО САМ ДА ОТВОРИМ ДРУГАЧИЈИ НАРАТИВ.</em></h3>
      </div>
      <p class="internet-bridge">Интернет и терен нису били одвојени светови. Оно што сам видео на терену преносио сам људима на интернету. А оно што се покретало кроз разговоре и објаве добијало је наставак кроз сусрете, изложбе и конкретне активности.</p>
    </section>

    <section class="closing-section">
      <p class="section-kicker">ЈЕДАН ПУТ · ВИШЕ НАЧИНА ДЕЛОВАЊА</p>
      <h2>МЕЊАЛИ СУ СЕ<br /><em>АЛАТИ. НЕ И ПОТРЕБА ДА ДЕЛУЈЕМ.</em></h2>
      <p>Ово је део мог активизма који обухвата период од 2000. до 2010. године, док моје коришћење интернета почиње још 2005. Ова страница ће се допуњавати како будемо сређивали и остале периоде и активности — без измишљања и без улепшавања онога што се заиста догодило.</p>
      <a href={base + 'moja-borba/'} class="back-link">НАЗАД НА МОЈУ БОРБУ <span>↗</span></a>
    </section>
  </main>

  <style>
    :global(html){scroll-behavior:smooth;background:#101010}
    :global(body){background:#101010!important;color:#eee!important}
    .activism-page{--red:#e44743;--muted:#a9a6a0;--line:#383633;background:#101010;color:#eee;overflow:hidden}
    .activism-hero{min-height:690px;min-height:calc(90svh - 68px);position:relative;display:flex;align-items:center;padding:100px max(24px,calc((100vw - 1050px)/2));background:radial-gradient(ellipse at 78% 32%,#462523 0%,#201918 32%,#101010 72%)}
    .activism-hero:after{content:"";position:absolute;width:min(55vw,650px);aspect-ratio:1;right:-14%;top:8%;border:1px solid #e4474330;border-radius:50%;box-shadow:0 0 0 55px #e4474308,0 0 0 110px #e4474305;pointer-events:none}
    .activism-hero-inner{position:relative;z-index:1;max-width:900px}
    .eyebrow,.section-kicker,.item-label,.internet-overline{font-size:9px;font-weight:850;letter-spacing:.2em;color:var(--red)}
    .eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:28px}
    .eyebrow span{width:7px;height:7px;border-radius:50%;background:var(--red)}
    .activism-hero h1{font:900 clamp(58px,9vw,112px)/.9 'Barlow Condensed','Arial Narrow',sans-serif;letter-spacing:-.025em;margin:0 0 30px}
    .activism-hero h1 em,.section-heading h2 em,.internet-heading h2 em,.narrative-line h3 em,.closing-section h2 em{font-style:normal;color:var(--red)}
    .hero-lead{max-width:610px;color:#c3beb8;font-size:16px;line-height:1.85;margin:0}
    .hero-tags{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:36px;color:#aaa;font-size:8px;font-weight:850;letter-spacing:.16em}
    .hero-tags i{width:4px;height:4px;background:var(--red);border-radius:50%}
    .hero-index{position:absolute;left:max(24px,calc((100vw - 1050px)/2));bottom:27px;color:#8d8984;font-size:8px;letter-spacing:.18em}
    .timeline-section,.field-section{padding:105px max(24px,calc((100vw - 1000px)/2))}
    .timeline-section{background:#e9e7e2;color:#171615}
    .section-heading{display:grid;grid-template-columns:1fr 1fr;column-gap:70px;align-items:end;margin-bottom:55px}
    .section-heading .section-kicker{grid-column:1/-1;margin:0 0 25px}
    .section-heading h2{font:900 clamp(42px,6vw,70px)/.95 'Barlow Condensed','Arial Narrow',sans-serif;letter-spacing:-.02em;margin:0}
    .section-heading>p:last-child{max-width:390px;color:#6c6862;font-size:13px;line-height:1.85;margin:0}
    .timeline{border-top:1px solid #c7c3bb}
    .timeline-item{display:grid;grid-template-columns:180px 1fr;gap:30px;padding:31px 0;border-bottom:1px solid #c7c3bb}
    .timeline-period{display:flex;flex-direction:column;gap:10px}
    .timeline-period span{font-size:9px;color:#8b857d;letter-spacing:.14em}
    .timeline-period b{font:900 33px 'Barlow Condensed',sans-serif;color:var(--red)}
    .item-label{margin:0 0 10px;color:#a23b37;font-size:8px}
    .timeline-copy h3{font:850 clamp(22px,3vw,31px)/1.12 Manrope,sans-serif;letter-spacing:-.045em;margin:0 0 12px}
    .timeline-copy>p:last-child{max-width:690px;color:#5d5954;font-size:13px;line-height:1.85;margin:0}
    .field-section{background:#141312}
    .field-section .section-heading h2{color:#f1eee9}
    .field-section .section-heading>p:last-child{color:#aaa59e}
    .field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}
    .field-card{position:relative;min-height:230px;padding:27px 28px 30px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
    .field-number{display:block;color:var(--red);font-size:9px;letter-spacing:.16em;margin-bottom:25px}
    .field-card h3{font:800 21px/1.12 Manrope,sans-serif;letter-spacing:-.04em;margin:0 0 14px}
    .field-card p{font-size:12px;line-height:1.8;color:#aaa59e;margin:0}
    .field-quote{margin:55px 0 0;padding:34px 0 0;border-top:1px solid var(--line)}
    .field-quote blockquote{max-width:800px;margin:0;color:#f2efeb;font:750 clamp(24px,3.5vw,38px)/1.3 Manrope,sans-serif;letter-spacing:-.04em}
    .field-quote figcaption{margin-top:22px;color:var(--red);font-size:8px;font-weight:850;letter-spacing:.18em}
    .internet-section{padding:100px max(24px,calc((100vw - 1000px)/2));background:#e9e7e2;color:#171615}
    .internet-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #c7c3bb;padding-bottom:20px}
    .internet-top .section-kicker{margin:0;color:#a23b37}
    .internet-mark{font-size:9px;letter-spacing:.15em;color:#827d75}
    .internet-heading{max-width:760px;padding:55px 0 35px}
    .internet-overline{margin:0 0 18px;color:#a23b37}
    .internet-heading h2{font:900 clamp(55px,9vw,100px)/.86 'Barlow Condensed','Arial Narrow',sans-serif;letter-spacing:-.025em;margin:0 0 24px}
    .internet-heading h2 em{color:#d53d3c}
    .internet-lead{max-width:650px;color:#4e4a45;font:600 clamp(17px,2vw,21px)/1.65 Manrope,sans-serif;margin:0}
    .internet-body{display:grid;grid-template-columns:1.3fr .7fr;gap:65px;padding:35px 0 45px;border-top:1px solid #c7c3bb}
    .internet-story p{font-size:14px;line-height:1.9;color:#4e4a45;margin:0 0 19px}
    .internet-story strong{color:#171615}
    .forum-list{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px}
    .forum-list span{padding:9px 12px;border:1px solid #c4bfb7;color:#3d3935;font-size:10px;font-weight:750}
    .internet-principle{align-self:start;padding:25px;background:#171615;color:#f1eee9;border-bottom:4px solid var(--red)}
    .internet-principle>span{color:#e66a62;font-size:8px;font-weight:850;letter-spacing:.18em}
    .internet-principle p{font:750 19px/1.45 Manrope,sans-serif;letter-spacing:-.03em;margin:19px 0 0}
    .internet-belief{padding:34px 0 38px;border-top:1px solid #c7c3bb}
    .belief-label{font-size:8px;font-weight:850;letter-spacing:.18em;color:#a23b37}
    .internet-belief h3{font:900 clamp(30px,4.8vw,52px)/1.08 'Barlow Condensed',sans-serif;letter-spacing:-.015em;margin:16px 0 20px}
    .internet-belief h3 em{font-style:normal;color:#d53d3c}
    .internet-belief>p:not(.belief-label){max-width:760px;color:#55504a;font-size:13px;line-height:1.9;margin:12px 0}
    .narrative-line{padding:28px 0 30px;border-top:1px solid #c7c3bb;border-bottom:1px solid #c7c3bb}
    .narrative-line>span{font-size:8px;font-weight:850;letter-spacing:.18em;color:#a23b37}
    .narrative-line h3{max-width:850px;margin:17px 0 0;font:900 clamp(27px,4vw,43px)/1.1 'Barlow Condensed',sans-serif;letter-spacing:-.015em}
    .narrative-line h3 em{color:#d53d3c}
    .internet-bridge{max-width:760px;margin:28px 0 0;color:#55504a;font-size:13px;line-height:1.9}
    .closing-section{padding:95px 24px 115px;text-align:center;background:#0d0d0d}
    .closing-section h2{font:900 clamp(42px,7vw,76px)/.95 'Barlow Condensed',sans-serif;margin:0 auto 25px;max-width:850px}
    .closing-section>p:not(.section-kicker){max-width:680px;margin:0 auto;color:#aaa59e;font-size:13px;line-height:1.9}
    .back-link{display:inline-flex;gap:25px;align-items:center;margin-top:34px;padding:14px 18px;border:1px solid #5a5550;color:#f3f0eb;font-size:8px;font-weight:850;letter-spacing:.15em}
    .back-link span{color:var(--red);font-size:16px}
    @media(max-width:700px){
      .activism-hero{min-height:660px;min-height:calc(88svh - 68px);align-items:flex-end;padding:70px 23px 105px}
      .activism-hero h1{font-size:clamp(48px,13vw,76px);line-height:.94}
      .hero-lead{font-size:14px;line-height:1.75}
      .hero-tags{gap:8px;margin-top:25px;font-size:7px}
      .hero-index{left:23px;bottom:23px;font-size:7px}
      .timeline-section,.field-section,.internet-section{padding:72px 22px}
      .section-heading{display:block;margin-bottom:35px}
      .section-heading .section-kicker{margin-bottom:20px}
      .section-heading h2{font-size:clamp(42px,11vw,58px);margin-bottom:18px}

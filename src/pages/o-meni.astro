---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const chapters = [
  { no: '01', title: 'Рођење и одрастање', desc: 'Моја прича почиње у Београду, 1981. године. Одрастао сам између два оца, два ауторитета и два различита погледа на свет. Тај однос није ми дао готове одговоре, али је поставио темеље мог карактера и научио ме да свет посматрам из више углова.', href: base + 'odrastanje/' },
  { no: '02', title: 'Преиспитивање', desc: 'Из тих различитих погледа родила су се питања која су ме пратила кроз живот: шта је нормално, шта је исправно и ко одређује границу између тога? Почео сам да сумњам у готове одговоре и да тражим смисао иза онога што се подразумева.', href: base + 'nekonformizam/' },
  { no: '03', title: 'Потрага за сопственим путем', desc: 'Када једном почнеш да преиспитујеш свет, неминовно дођеш и до питања сопственог места у њему. Суочавао сам се са туђим очекивањима, конформизмом и потребом да изградим уверења иза којих могу да станем, чак и када се разликују од већине.', href: base + 'moj-put/' },
  { no: '04', title: 'Мој бунт', desc: 'Преиспитивање за мене није остало само на размишљању. Доšao је тренутак када више нисам могао да прихватам неправду, страх и наметнута правила као нешто на шта човек мора да пристане. Мој бунт је постао начин да своја уверења претворим у став и деловање.', href: base + 'moja-borba/' },
  { no: '05', title: 'Јуначко срце', desc: 'Временом сам схватио да борба не мора да буде само отпор. Она може да буде и пружена рука, подршка, повезивање људи и охрабривање других да направе свој корак. Тако је настало Јуначко срце — из уверења да вредности имају смисла тек када их претворимо у дела.', href: base + 'junacko-srce/' }
];
---
<BaseLayout title="О мени — Јовица Вратница" description="Моја животна прича, борба, Јуначко Срце и подршка онима који се усуде.">
  <div class="about-app">
    <header class="about-topbar">
      <a class="about-back" href={base} aria-label="Назад на почетну">←</a>
      <a class="about-top-title" href={base}>ЈОВИЦА ВРАТНИЦА</a>
      <a class="about-home" href={base} aria-label="Почетна">⌂</a>
    </header>

    <main>
      <section class="about-hero">
        <img class="about-hero-photo" src={base + 'images/jovica-uvod.jpg'} alt="Јовица Вратница на јавном окупљању" />
        <div class="about-hero-shade"></div>
        <div class="about-hero-content">
          <p class="about-kicker">ЛИЧНА ПРИЧА · МОЈ ПУТ</p>
          <h1 class="about-signature">Јовица<br/>Вратница<span>.</span></h1>
          <p class="about-main-motto">Ја сам ту за оне<br/>који се усуде.</p>
          <p class="about-motto">Пишем. Делујем. Повезујем.</p>
          <p class="about-identity">ФИЛОЗОФ · ИДЕАЛИСТА · БУНТОВНИК · ПУТНИК<br/>ЧОВЕК КОЈИ РАДИ СРЦЕМ</p>
          <a class="about-primary-button" href="#price">УПОЗНАЈ МОЈУ ПРИЧУ <span>↓</span></a>
        </div>
        <div class="about-hero-bottom">
          <span>НЕ ПРИСТАЈЕМ ДА ЖИВОТ ПРОЂЕ У ЋУТАЊУ.</span>
          <span>01 / 04</span>
        </div>
      </section>

      <section class="about-story" id="odrastanje">
        <div class="about-section-label"><span>01</span> БИОГРАФИЈА ЈОВИЦЕ ВРАТНИЦЕ</div>
        <h2>Мој животни пут —<br/><em>од одрастања до деловања.</em></h2>
        <p class="about-lead"><a class="about-inline-link" href={base + 'odrastanje/'}>Рођен сам у Београду 1981. године.</a> Одрастао сам између два ауторитета – оца и очуха – и два различита погледа на свет. Тај сусрет обликовао је моју личност и пробудио потребу да самостално размишљам.</p>
        <p class="about-bio-step"><a class="about-inline-link" href={base + 'nekonformizam/'}>Почео сам да преиспитујем свет око себе.</a> Питање „Шта је нормално?“ постало је једно од главних питања мог живота. Нисам желео да прихватам друштвене норме и уверења само зато што их већина сматра исправним.</p>
        <p class="about-bio-step"><a class="about-inline-link" href={base + 'moj-put/'}>Кренуо сам у потрагу за сопственим путем.</a> Преиспитивао сам конформизам, откривао неконформизам и градио сопствена уверења, чак и када су ме она удаљавала од очекивања околине.</p>
        <p class="about-bio-step"><a class="about-inline-link" href={base + 'moja-borba/'}>Временом сам схватио да морам да се побуним.</a> Није ми било довољно да само посматрам и постављам питања. Морао сам да се успротивим неправди, ограничењима слободе и нормама које сам сматрао погрешним.</p>
        <p class="about-bio-step"><a class="about-inline-link" href={base + 'junacko-srce/'}>Из тог бунта настало је Јуначко срце.</a> Моја тежња да лична уверења претворим у дела, подршку људима, повезивање и борбу за друштво у којем желим да живим.</p>
        <details class="about-more">
          <summary><span>ВИДИ ВИШЕ О МОЈЕМ ОДРАСТАЊУ</span><b>＋</b></summary>
          <div class="about-more-content">
            <p>Одрастање између та два ауторитета значило је сусрет са два различита начина разумевања живота. Са једне стране били су послушност, дисциплина и прихватање ствари онаквим какве јесу. Са друге стране, слобода да постављам питања, да преиспитујем оно што ми се представља као једино исправно и да преузмем одговорност за сопствене изборе.</p>
            <p>Тај судар није ми дао готове одговоре. Научио ме је да их тражим. Управо ту видим један од корена свог бунта — у потреби да не прихватам свет без питања и да сам одлучујем у шта верујем.</p>
          </div>
        </details>
        <p>Никада нисам био конформиста. Нисам прихватао ствари здраво за готово нити веровао да је нешто исправно само зато што већина тако мисли. Увек сам преиспитивао наметнуте норме, тражио сопствени пут и бунтовао против неправде и ограничења слободе. Мој животни пут је зато прича о одрастању, преиспитивању, тражењу себе и бунту који је временом прерастао у конкретно деловање.</p>
      </section>

      <section class="about-manifesto" id="price">
        <span class="about-quote-mark">“</span>
        <blockquote>Знам како је када се бориш и када немаш увек некога поред себе. Зато желим да пружим руку другима — да знају да нису сами.</blockquote>
        <p>НЕ ДА СПАСАВАМ. ВЕЋ ДА ПОДРЖИМ.</p>
      </section>



      <section class="about-chapters" aria-label="Поглавља мог животног пута">
        <div class="about-section-label"><span>02</span> ПЕТ ПОГЛАВЉА МОГ ЖИВОТНОГ ПУТА</div>
        <h2 class="about-journey-heading">Свака фаза је оставила траг.<br/><em>Свака ме је водила ка следећој.</em></h2>
        <p class="about-journey-intro">Ово није пет одвојених прича. То је један животни пут — од онога што сам понео из детињства, преко питања која су ме обликовала, до бунта и деловања које данас живим.</p>
        <div class="about-journey-list">
          {chapters.map((item) => (
            <article class="about-journey-item">
              <span class="about-menu-no">{item.no} / ПОГЛАВЉЕ</span>
              <div class="about-journey-copy">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
                <a class="about-journey-link" href={item.href}>ПРОЧИТАЈ ЦЕЛУ ПРИЧУ <span>↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-mission">
        <div class="about-section-label"><span>03</span> МОЈА МИСИЈА</div>
        <h2>Не желим да спасавам.<br/><em>Желим да пружим руку.</em></h2>
        <p class="about-mission-big">Да охрабрим. Да подржим. Да повежем. Да људи знају да нису сами.</p>
        <p>Верујем у људе који имају идеју, храброст и жељу да нешто промене. Не желим да говорим уместо њих, нити да им одузимам снагу. Желим да их охрабрим, повежем и подржим да сами направе свој корак.</p>
      </section>

      <section class="about-call">
        <p>ЗА ОНЕ КОЈИ СЕ УСУДЕ</p>
        <h2>Пишем.<br/>Делујем.<br/><em>Повезујем.</em></h2>
        <a href={base + 'podrska/'}>УПОЗНАЈ МОЈУ ПОДРШКУ <span>↗</span></a>
      </section>
    </main>

    <nav class="about-bottom-nav" aria-label="Главна навигација">
      <a href={base}><span>⌂</span>Почетна</a>
      <a class="active" href={base + 'o-meni/'}><span>●</span>О мени</a>
      <a href={base + 'junacko-srce/'}><span>♡</span>Јуначко Срце</a>
      <a href={base + 'projekti/'}><span>▦</span>Пројекти</a>
      <a href={base + 'saradnja/'}><span>↗</span>Сарадња</a>
    </nav>
  </div>
  <style>
    .about-inline-link{color:inherit;text-decoration-color:#e5484d;text-decoration-thickness:2px;text-underline-offset:4px;font-weight:850;transition:color .2s}.about-inline-link:hover{color:#e5484d}.about-bio-step{font-size:1.02rem;line-height:1.85;margin:18px 0;color:inherit;opacity:.92}
    .about-more{margin:22px 0 28px;border:1px solid rgba(229,72,77,.45);background:rgba(229,72,77,.045)}
    .about-more summary{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 18px;cursor:pointer;list-style:none;color:inherit;font-size:.72rem;font-weight:850;letter-spacing:.1em}
    .about-more summary::-webkit-details-marker{display:none}
    .about-more summary b{color:#e5484d;font-size:1.2rem;transition:transform .2s}
    .about-more[open] summary b{transform:rotate(45deg)}
    .about-more-content{padding:0 18px 16px;border-top:1px solid rgba(229,72,77,.2)}
    .about-more-content p{font-size:.96rem;line-height:1.8;color:inherit;opacity:.88;margin:14px 0 0}
    .about-top-title{color:inherit;text-decoration:none;font-size:.72rem;font-weight:800;letter-spacing:.13em}
    .about-hero{position:relative;isolation:isolate;overflow:hidden;min-height: min(790px, calc(100svh - 56px));background:#111}
    .about-hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;z-index:-2;filter:grayscale(1) contrast(1.08)}
    .about-hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(8,9,12,.92) 0%,rgba(8,9,12,.58) 58%,rgba(8,9,12,.15) 100%),linear-gradient(0deg,rgba(8,9,12,.78),transparent 45%)}
    .about-hero-content{position:relative;max-width:780px;padding:clamp(90px,15vw,175px) clamp(24px,7vw,90px) 130px;color:#fff}
    .about-signature{font-size:clamp(3.3rem,8vw,6.8rem);line-height:.9;letter-spacing:-.065em;margin:15px 0 26px;font-weight:850}
    .about-signature span{color:#e5484d}
    .about-main-motto{font-size:clamp(1.9rem,4.5vw,3.7rem);font-weight:850;line-height:1.04;letter-spacing:-.045em;margin:0 0 18px}
    .about-motto{font-size:1rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
    .about-identity{margin:22px 0 0;color:#e6e7e9;font-size:.72rem;line-height:1.9;font-weight:850;letter-spacing:.12em}.about-primary-button{display:inline-flex;gap:26px;align-items:center;margin-top:28px;padding:14px 18px;border:1px solid rgba(255,255,255,.55);color:white;text-decoration:none;font-size:.75rem;font-weight:800;letter-spacing:.1em}
    .about-primary-button span{color:#ef555a;font-size:1.2rem}
    .about-hero-bottom{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;padding:18px clamp(24px,7vw,90px);color:#fff;font-size:.65rem;font-weight:800;letter-spacing:.12em}
    .about-journey-heading{font-size:clamp(1.8rem,4vw,3rem);line-height:1.08;letter-spacing:-.04em;margin:24px 0 14px;color:#f4f4f4}.about-journey-heading em{color:#e5484d;font-style:normal}.about-journey-intro{max-width:760px;color:#c2c5cc;line-height:1.8;font-size:1rem;margin:0 0 34px}.about-journey-list{display:flex;flex-direction:column;gap:0;border-top:1px solid rgba(255,255,255,.14)}.about-journey-item{display:grid;grid-template-columns:110px minmax(0,1fr);gap:24px;padding:28px 0;border-bottom:1px solid rgba(255,255,255,.14)}.about-menu-no{font-size:.68rem;color:#e5484d;font-weight:800;letter-spacing:.13em;padding-top:8px}.about-journey-copy h3{font-size:clamp(1.35rem,3vw,2rem);line-height:1.15;margin:0 0 12px;color:#f4f4f4}.about-journey-copy p{max-width:780px;font-size:1rem;line-height:1.8;color:#c2c5cc;margin:0 0 18px}.about-journey-link{display:inline-flex;gap:18px;align-items:center;color:#f4f4f4;text-decoration:none;font-size:.7rem;font-weight:850;letter-spacing:.1em;border-bottom:1px solid rgba(229,72,77,.7);padding:0 0 7px}.about-journey-link span{font-size:1.15rem;color:#e5484d}.about-journey-link:hover{color:#e5484d}
    @media(max-width:640px){.about-journey-item{grid-template-columns:1fr;gap:8px;padding:23px 0}.about-journey-copy p{font-size:.94rem}.about-hero-content{padding-top:105px}.about-hero-bottom{font-size:.55rem}}
  </style>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

---
<BaseLayout title="О мени — Јовица Вратница" description="Моја животна прича, борба, Јуначко Срце и подршка онима који се усуде.">
  <div class="about-app">
    <main>
      <section class="about-hero">
        <img class="about-hero-photo" src={base + 'images/jovica-uvod.jpg'} alt="Јовица Вратница на јавном окупљању" />
        <div class="about-hero-shade"></div>
        <div class="about-hero-content">
          <p class="about-kicker">ЛИЧНА ПРИЧА · МОЈ ПУТ</p>
          <h1 class="about-signature">Јовица<br/>Вратница<span>.</span></h1>
          <p class="about-hero-intro">Рођен сам у Београду 1981. године, у граду који је врвео од живота и гушио се у сопственим противречностима. Одбацујем идеју да треба да следим вредности само зато што су друштвено прихваћене. Онда прихватам — нисам нормалан.</p>
          <button class="about-primary-button" type="button" onclick="document.getElementById('story-menu').showModal()">УПОЗНАЈ МОЈУ ПРИЧУ <span>↓</span></button>
        </div>
        <div class="about-hero-bottom">
          <span>НЕ ПРИСТАЈЕМ ДА ЖИВОТ ПРОЂЕ У ЋУТАЊУ.</span>
          <span>01 / 04</span>
        </div>
      </section>



      <dialog class="story-menu" id="story-menu" aria-labelledby="story-menu-title">
        <div class="story-menu-handle"></div>
        <div class="story-menu-head">
          <div>
            <p>МОЈ ЖИВОТНИ ПУТ</p>
            <h2 id="story-menu-title">Девет поглавља.<br/><em>Једна прича.</em></h2>
          </div>
          <button class="story-menu-close" type="button" aria-label="Затвори" onclick="document.getElementById('story-menu').close()">×</button>
        </div>
        <div class="story-menu-list">
          <article><span>01</span><div><h3>Два оца, два погледа на свет</h3><p>Моја прича почиње одрастањем између два оца, два ауторитета и два различита погледа на свет.</p></div><b>↗</b></article>
          <article><span>02</span><div><h3>Неконформиста сам откад знам за себе</h3><p>Потреба да постављам питања и не прихватам правила само зато што их већина следи.</p></div><b>↗</b></article>
          <article><span>03</span><div><h3>Потрага за сопственим путем</h3><p>Учење да доносим сопствене одлуке и останем веран својим уверењима.</p></div><b>↗</b></article>
          <article><span>04</span><div><h3>Слобода и аутентичност</h3><p>Зашто нисам желео да живим по туђим очекивањима и мерилима успеха.</p></div><b>↗</b></article>
          <article><span>05</span><div><h3>Супротстављање ауторитетима</h3><p>Однос према правилима, ауторитетима и људима који су ме подстицали да мислим својом главом.</p></div><b>↗</b></article>
          <article><span>06</span><div><h3>Сукоб са школским системом</h3><p>Искуства из школе и борба за право на радозналост, слободу мишљења и изражавања.</p></div><b>↗</b></article>
          <article><span>07</span><div><h3>Од личног бунта до друштвене побуне</h3><p>Како се преиспитивање личних ауторитета проширило на друштво и политички систем.</p></div><b>↗</b></article>
          <article><span>08</span><div><h3>Искуства која су ме обликовала</h3><p>Људи, ангажовање, путовања и различити послови који су проширили мој поглед на свет.</p></div><b>↗</b></article>
          <article><span>09</span><div><h3>Проналажење сопственог позива</h3><p>Како сам кроз различита искуства почео да повезујем оно у шта верујем са оним што радим.</p></div><b>↗</b></article>
        </div>
        <p class="story-menu-note">НАСЛОВИ СУ ЗА САДА ПРИКАЗНИ — САДРЖАЈ ЋЕМО ДОРАЂИВАТИ КАСНИЈЕ.</p>
      </dialog>
      <script>
        const storyMenu = document.getElementById('story-menu');
        storyMenu?.addEventListener('click', (event) => {
          if (event.target === storyMenu) storyMenu.close();
        });
      </script>

    </main>

  </div>
  <style>
    .about-primary-button{display:inline-flex;gap:26px;align-items:center;margin-top:28px;padding:15px 20px;border:1px solid rgba(255,255,255,.65);color:white;text-decoration:none;background:rgba(255,255,255,.06);font:800 .75rem inherit;letter-spacing:.1em;cursor:pointer;backdrop-filter:blur(8px)}
    .about-primary-button span{color:#ef555a;font-size:1.2rem}
    .story-menu{position:fixed;inset:auto 0 0;margin:0 auto 0;width:min(760px,100%);max-width:none;max-height:min(86dvh,780px);overflow-y:auto;padding:18px clamp(20px,5vw,38px) 30px;border:1px solid rgba(255,255,255,.15);border-bottom:0;border-radius:22px 22px 0 0;color:#eeeae5;background:linear-gradient(145deg,#292522,#151413 78%);box-shadow:0 -18px 70px rgba(0,0,0,.5)}
    .story-menu[open]{animation:story-sheet-in .24s ease-out}
    .story-menu::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(5px)}
    @keyframes story-sheet-in{from{transform:translateY(35px);opacity:.65}to{transform:translateY(0);opacity:1}}
    .story-menu-handle{width:42px;height:4px;margin:0 auto 25px;border-radius:9px;background:#77716b}
    .story-menu-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:22px}
    .story-menu-head p{margin:0 0 8px;color:#e5484d;font-size:.65rem;font-weight:850;letter-spacing:.18em}
    .story-menu-head h2{margin:0;font-size:clamp(1.65rem,4vw,2.3rem);line-height:1.08;letter-spacing:-.045em}
    .story-menu-head h2 em{color:#e5484d;font-style:normal}
    .story-menu-close{width:38px;height:38px;flex:0 0 38px;border:1px solid #625b55;border-radius:50%;color:#fff;background:transparent;font-size:25px;cursor:pointer}
    .story-menu-list{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .story-menu-list article{display:grid;grid-template-columns:27px minmax(0,1fr) 15px;gap:10px;align-items:start;min-height:106px;padding:15px 13px;border:1px solid rgba(255,255,255,.13);border-radius:5px;background:rgba(255,255,255,.035)}
    .story-menu-list article>span{padding-top:3px;color:#e5484d;font-size:.68rem;font-weight:850;letter-spacing:.08em}
    .story-menu-list h3{margin:0 0 7px;color:#f4f1ed;font-size:.93rem;line-height:1.25}
    .story-menu-list p{margin:0;color:#bbb5ae;font-size:.78rem;line-height:1.55}
    .story-menu-list article>b{color:#e5484d;font-size:.95rem;font-weight:500}
    .story-menu-note{margin:18px 0 0;color:#8f8982;font-size:.58rem;font-weight:800;letter-spacing:.12em;line-height:1.6}
    @media(max-width:600px){.story-menu{padding:14px 18px 25px}.story-menu-list{grid-template-columns:1fr}.story-menu-list article{min-height:0;padding:13px}.about-hero-content{padding-bottom:110px}}
    .about-hero-intro{max-width:660px;margin:0 0 26px;font-size:clamp(.98rem,1.5vw,1.12rem);line-height:1.75;color:#f2f2f2;text-wrap:pretty}
    .about-bio-step{font-size:1.02rem;line-height:1.85;margin:0 0 14px;color:inherit;opacity:.92}.about-story-chapter{padding:0 0 22px;margin:0 0 22px;border-bottom:1px solid rgba(255,255,255,.12)}.about-read-more{display:inline-flex;gap:16px;align-items:center;color:#f2f2f2;text-decoration:none;font-size:.7rem;font-weight:850;letter-spacing:.1em;padding:0 0 7px;border-bottom:1px solid rgba(229,72,77,.75)}.about-read-more span{color:#e5484d;font-size:1.1rem}.about-read-more:hover{color:#e5484d}.about-story-ending{margin-top:30px;font-size:1.02rem;line-height:1.85;color:inherit;opacity:.94}
    .about-more{margin:22px 0 28px;border:1px solid rgba(229,72,77,.45);background:rgba(229,72,77,.045)}
    .about-more summary{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 18px;cursor:pointer;list-style:none;color:inherit;font-size:.72rem;font-weight:850;letter-spacing:.1em}
    .about-more summary::-webkit-details-marker{display:none}
    .about-more summary b{color:#e5484d;font-size:1.2rem;transition:transform .2s}
    .about-more[open] summary b{transform:rotate(45deg)}
    .about-more-content{padding:0 18px 16px;border-top:1px solid rgba(229,72,77,.2)}
    .about-more-content p{font-size:.96rem;line-height:1.8;color:inherit;opacity:.88;margin:14px 0 0}
    .about-top-title{color:inherit;text-decoration:none;font-size:.72rem;font-weight:800;letter-spacing:.13em}
    .about-hero{position:relative;isolation:isolate;overflow:hidden;min-height: min(790px, calc(100svh - 56px));background:#111}
    .about-hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;z-index:-2;filter:grayscale(1) contrast(1.08)}
    .about-hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(8,9,12,.92) 0%,rgba(8,9,12,.58) 58%,rgba(8,9,12,.15) 100%),linear-gradient(0deg,rgba(8,9,12,.78),transparent 45%)}
    .about-hero-content{position:relative;max-width:780px;padding:clamp(90px,15vw,175px) clamp(24px,7vw,90px) 130px;color:#fff}
    .about-signature{font-size:clamp(3.3rem,8vw,6.8rem);line-height:.9;letter-spacing:-.065em;margin:15px 0 26px;font-weight:850}
    .about-signature span{color:#e5484d}
    .about-main-motto{font-size:clamp(1.9rem,4.5vw,3.7rem);font-weight:850;line-height:1.04;letter-spacing:-.045em;margin:0 0 18px}
    .about-motto{font-size:1rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
    .about-identity{margin:22px 0 0;color:#e6e7e9;font-size:.72rem;line-height:1.9;font-weight:850;letter-spacing:.12em}.about-primary-button{display:inline-flex;gap:26px;align-items:center;margin-top:28px;padding:14px 18px;border:1px solid rgba(255,255,255,.55);color:white;text-decoration:none;font-size:.75rem;font-weight:800;letter-spacing:.1em}
    .about-primary-button span{color:#ef555a;font-size:1.2rem}
    .about-hero-bottom{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;padding:18px clamp(24px,7vw,90px);color:#fff;font-size:.65rem;font-weight:800;letter-spacing:.12em}
    .about-journey-heading{font-size:clamp(1.8rem,4vw,3rem);line-height:1.08;letter-spacing:-.04em;margin:24px 0 14px;color:#f4f4f4}.about-journey-heading em{color:#e5484d;font-style:normal}.about-journey-intro{max-width:760px;color:#c2c5cc;line-height:1.8;font-size:1rem;margin:0 0 34px}.about-journey-list{display:flex;flex-direction:column;gap:0;border-top:1px solid rgba(255,255,255,.14)}.about-journey-item{display:grid;grid-template-columns:110px minmax(0,1fr);gap:24px;padding:28px 0;border-bottom:1px solid rgba(255,255,255,.14)}.about-menu-no{font-size:.68rem;color:#e5484d;font-weight:800;letter-spacing:.13em;padding-top:8px}.about-journey-copy h3{font-size:clamp(1.35rem,3vw,2rem);line-height:1.15;margin:0 0 12px;color:#f4f4f4}.about-journey-copy p{max-width:780px;font-size:1rem;line-height:1.8;color:#c2c5cc;margin:0 0 18px}.about-journey-link{display:inline-flex;gap:18px;align-items:center;color:#f4f4f4;text-decoration:none;font-size:.7rem;font-weight:850;letter-spacing:.1em;border-bottom:1px solid rgba(229,72,77,.7);padding:0 0 7px}.about-journey-link span{font-size:1.15rem;color:#e5484d}.about-journey-link:hover{color:#e5484d}
    @media(max-width:640px){.about-journey-item{grid-template-columns:1fr;gap:8px;padding:23px 0}.about-journey-copy p{font-size:.94rem}.about-hero-bottom{font-size:.55rem}}
  </style>
</BaseLayout>
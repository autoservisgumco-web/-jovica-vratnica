---
import BaseLayout from '../layouts/BaseLayout.astro';
const sections = [
  {
    number: '01',
    id: 'o-meni',
    title: 'О мени',
    subtitle: 'Човек иза идеја, ставова и поступака.',
    intro: 'Ко сам, шта ме је обликовало, како размишљам и у шта верујем. Моја прича није само биографија, већ покушај да објасним човека иза свега што радим.',
    tone: 'light',
    chapters: [
      ['Рођен у Београду 1981.', 'Где је све почело и какво је било окружење у коме сам одрастао.'],
      ['Живот између два ауторитета', 'Одрастање уз различите погледе, савете и могућност да изградим сопствени став.'],
      ['Шта је нормално у свету који живи у хаосу?', 'Преиспитивање онога што друштво назива нормалним и онога што ја сматрам исправним.'],
      ['Слобода да будеш свој', 'Зашто нисам желео да живим по туђим очекивањима и мерилима.'],
      ['Филозоф, идеалиста и неконформиста', 'Начин на који посматрам свет и тражим смисао иза онога што видим.'],
      ['Вредности које ме покрећу', 'Слобода, аутентичност, интегритет и одговорност.'],
      ['Живот мора имати смисао', 'Зашто ми није довољно само да постојим и пролазим кроз дане.']
    ]
  },
  {
    number: '02',
    id: 'moja-borba',
    title: 'Моја борба',
    subtitle: 'Није почела јуче.',
    intro: 'Моја борба није настала преко ноћи. Није почела са друштвеним мрежама, политичким функцијама или неким новим пројектом. Она је део мог живота, мог начина размишљања и мог односа према неправди, слободи и људима.',
    tone: 'dark',
    chapters: [
      ['Моја борба није почела јуче', 'Почеци, прва искуства и пут који траје много дуже од данашњих пројеката.'],
      ['Борба против наметнутих правила', 'Преиспитивање ауторитета, правила и система који траже послушност уместо размишљања.'],
      ['Не пристајем на ћутање', 'Зашто постављам питања и зашто не желим да окрећем главу пред неправдом.'],
      ['Борба за слободу и достојанство', 'Вредности које браним и разлози због којих не одустајем од њих.'],
      ['Нисам против људи, већ против неправде', 'Суштина мог отпора није мржња према људима, већ неслагање са неправдом и равнодушношћу.'],
      ['Тридесет година бунта', 'Искуства, ангажовање и лекције које су временом обликовале мој поглед на свет.'],
      ['Од личног отпора до друштвеног деловања', 'Како је лична потреба да се супротставим неправди прерасла у конкретно деловање.'],
      ['Борба се наставља', 'Како данас изгледа моја борба и где усмеравам своју енергију.']
    ]
  },
  {
    number: '03',
    id: 'junacko-srce',
    title: 'Јуначко Срце',
    subtitle: 'Идеја претворена у дело.',
    intro: 'Јуначко Срце је настало из жеље да своје идеје, знање, креативност и искуство ставим у службу људи. Да маркетинг постане средство повезивања и позитивних друштвених промена, а не само продаје.',
    tone: 'red',
    chapters: [
      ['Како је настало Јуначко Срце', 'Од личне идеје до простора за стварање, повезивање и деловање.'],
      ['За људе, не за профит', 'Вредности на којима почива све што радимо.'],
      ['Маркетинг који буди, не продаје', 'Другачији поглед на маркетинг и његову моћ да покрене људе.'],
      ['Шта желимо да мењамо', 'Визија друштва у коме људи преузимају иницијативу и одговорност.'],
      ['Одговорна Плана', 'Када идеја о одговорности постане конкретно деловање у локалној заједници.'],
      ['Људи који желе нешто да покрену', 'Подршка онима који имају идеју, али им треба помоћ да направе први корак.'],
      ['Стварање кроз заједништво', 'Кампање, пројекти, производи и сарадње које повезују људе око добрих идеја.'],
      ['Имаш идеју? Хајде да је остваримо.', 'Позив свима који желе да покрену нешто смислено.']
    ]
  }
];
---
<BaseLayout title="О мени — Јовица Вратница" description="Упознај Јовицу Вратницу: његову животну причу, борбу и Јуначко Срце.">
  <main class="profile-page">
    <section class="profile-hero">
      <div class="hero-grain"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span></span> ЛИЧНА ПРИЧА · МОЈ ПУТ</p>
        <h1>Јовица<br/>Вратница<span>.</span></h1>
        <p class="hero-subtitle">Бунтовник, неконформиста и филозоф идеала који ради срцем.</p>
        <p class="hero-intro">Нисам овде да бих се представио као неко ко има све одговоре. Желим да испричам своју причу, поделим своја искуства, ставове и идеје. Да покажем шта ме је обликовало, за шта сам се борио и зашто сам одлучио да од својих уверења створим нешто конкретно.</p>
        <p class="hero-intro">Мој пут има три важне целине: човек који сам постао, борба која ме је обликовала и идеја коју сам претворио у дело.</p>
        <a class="hero-cta" href="#tri-puta">УПОЗНАЈ МОЈ ПУТ <span>↓</span></a>
      </div>
      <div class="hero-foot"><span>НЕ ПРИСТАЈЕМ ДА ЖИВОТ ПРОЂЕ У ЋУТАЊУ.</span><span>01 / 03</span></div>
    </section>

    <nav class="chapter-jump" id="tri-puta" aria-label="Три целине">
      <a href="#o-meni"><span>01</span> О мени <b>↘</b></a>
      <a href="#moja-borba"><span>02</span> Моја борба <b>↘</b></a>
      <a href="#junacko-srce"><span>03</span> Јуначко Срце <b>↘</b></a>
    </nav>

    {sections.map((section) => (
      <section class:list={['profile-section', section.tone]} id={section.id}>
        <div class="section-inner">
          <div class="section-topline"><span>{section.number} / 03</span><span>ЈОВИЦА ВРАТНИЦА</span></div>
          <div class="section-heading">
            <div>
              <p class="section-label"> {section.number === '01' ? 'ЧОВЕК' : section.number === '02' ? 'ПУТ И ОТПОР' : 'ИДЕЈА И ДЕЛО'} </p>
              <h2>{section.title}<span>.</span></h2>
              <h3>{section.subtitle}</h3>
            </div>
            <p class="section-intro">{section.intro}</p>
          </div>
          <div class="chapter-list">
            {section.chapters.map((chapter, index) => (
              <details class="chapter">
                <summary>
                  <span class="chapter-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="chapter-title">{chapter[0]}</span>
                  <span class="chapter-toggle">+</span>
                </summary>
                <div class="chapter-detail">
                  <p>{chapter[1]}</p>
                  <span>ПОГЛАВЉЕ У ПРИПРЕМИ</span>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="closing">
      <p class="closing-kicker">ЗА СВЕ ШТО ДОЛАЗИ</p>
      <h2>Имаш идеју?<br/><em>Хајде да је остваримо.</em></h2>
      <p>Не мораш све да знаш. Не мораш имати готов план. Важно је да желиш да покренеш нешто добро. Ако имаш идеју, предлог или потребу да нешто промениш — јави се.</p>
      <a href="mailto:">ПОКРЕНИМО РАЗГОВОР <span>↗</span></a>
    </section>
  </main>

  <style>
    .profile-page{background:#101010;color:#e9e7e3;overflow:hidden}
    .profile-hero{position:relative;isolation:isolate;min-height:min(790px,calc(100svh - 68px));display:flex;align-items:center;padding:clamp(82px,12vw,150px) max(24px,calc((100vw - 1080px)/2)) 110px;background:radial-gradient(ellipse at 78% 38%,#38302c 0%,#1d1b1a 35%,#101010 76%)}
    .profile-hero:after{content:"";position:absolute;z-index:-1;width:min(46vw,620px);aspect-ratio:1;border:1px solid #ffffff18;border-radius:50%;right:-7%;top:10%;box-shadow:0 0 0 55px #ffffff05,0 0 0 110px #ffffff03}
    .hero-grain{position:absolute;inset:0;z-index:-1;opacity:.14;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.3'/%3E%3C/svg%3E")}
    .hero-copy{position:relative;z-index:1;max-width:780px}
    .eyebrow,.section-label,.closing-kicker{font-size:10px;letter-spacing:.2em;font-weight:800;color:#aaa49d}
    .eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 30px}
    .eyebrow span{width:7px;height:7px;border-radius:50%;background:#e44743}
    .profile-hero h1{font:800 clamp(62px,9.2vw,116px)/.91 Manrope,sans-serif;letter-spacing:-.075em;margin:0 0 25px;color:#f4f1ec}
    .profile-hero h1 span,.section-heading h2 span{color:#e44743}
    .hero-subtitle{font:700 clamp(18px,2.5vw,25px)/1.4 Manrope,sans-serif;letter-spacing:-.025em;color:#e9e4dd;max-width:660px;margin:0 0 22px}
    .hero-intro{max-width:690px;color:#bdb8b1;font-size:15px;line-height:1.85;margin:0 0 12px}
    .hero-cta{display:inline-flex;gap:34px;align-items:center;margin-top:23px;padding:15px 19px;border:1px solid #77716b;color:#f5f1eb;font-size:10px;font-weight:850;letter-spacing:.15em}
    .hero-cta span{color:#e44743;font-size:18px}
    .hero-foot{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;padding:20px max(24px,calc((100vw - 1080px)/2));border-top:1px solid #ffffff18;color:#aaa49d;font-size:9px;font-weight:800;letter-spacing:.16em}
    .chapter-jump{position:sticky;top:68px;z-index:10;display:grid;grid-template-columns:repeat(3,1fr);background:#171615;border-bottom:1px solid #343331}
    .chapter-jump a{display:flex;align-items:center;gap:13px;padding:22px clamp(14px,4vw,55px);border-right:1px solid #343331;font:750 14px Manrope,sans-serif}
    .chapter-jump a:last-child{border:0}.chapter-jump a>span{color:#e44743;font-size:10px}.chapter-jump a>b{margin-left:auto;color:#e44743;font-weight:500}.chapter-jump a:hover{background:#242220}
    .profile-section{padding:clamp(68px,9vw,112px) 24px}
    .profile-section.light{background:#e9e7e2;color:#171615}
    .profile-section.dark{background:#191817;color:#eeeae4}
    .profile-section.red{background:#812d31;color:#fff}
    .section-inner{max-width:1080px;margin:0 auto}
    .section-topline{display:flex;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid currentColor;opacity:.5;font-size:9px;font-weight:800;letter-spacing:.17em}
    .section-heading{display:grid;grid-template-columns:1fr .85fr;gap:9vw;align-items:end;padding:48px 0 55px}
    .section-label{margin:0 0 18px;color:#e44743}
    .section-heading h2{font:800 clamp(48px,7vw,82px)/.98 Manrope,sans-serif;letter-spacing:-.07em;margin:0 0 14px}
    .section-heading h3{font:650 clamp(18px,2.5vw,24px)/1.35 Manrope,sans-serif;letter-spacing:-.025em;margin:0;opacity:.75}
    .section-intro{font-size:15px;line-height:1.9;opacity:.78;margin:0;max-width:480px}
    .chapter-list{border-top:1px solid currentColor}
    .chapter{border-bottom:1px solid currentColor}
    .chapter summary{display:grid;grid-template-columns:70px minmax(0,1fr) 35px;align-items:center;gap:16px;padding:24px 0;cursor:pointer;list-style:none}
    .chapter summary::-webkit-details-marker{display:none}
    .chapter-number{font-size:11px;font-weight:850;letter-spacing:.12em;color:#e44743}
    .chapter-title{font:700 clamp(17px,2.3vw,22px)/1.35 Manrope,sans-serif;letter-spacing:-.025em}
    .chapter-toggle{width:29px;height:29px;border:1px solid currentColor;border-radius:50%;display:grid;place-items:center;font-size:19px;font-weight:400;transition:transform .2s,color .2s}
    .chapter[open] .chapter-toggle{transform:rotate(45deg);color:#e44743}
    .chapter-detail{padding:0 52px 24px 86px}
    .chapter-detail p{font-size:14px;line-height:1.8;opacity:.75;margin:0 0 12px;max-width:720px}
    .chapter-detail span{font-size:8px;letter-spacing:.16em;font-weight:850;color:#e44743}
    .closing{padding:clamp(75px,10vw,125px) 24px;background:#101010;text-align:left}
    .closing>*{max-width:900px;margin-left:auto;margin-right:auto}
    .closing-kicker{color:#e44743;margin-bottom:22px}
    .closing h2{font:800 clamp(42px,7vw,78px)/1.04 Manrope,sans-serif;letter-spacing:-.065em;margin-bottom:22px}
    .closing h2 em{color:#e44743;font-style:normal}
    .closing>p:not(.closing-kicker){color:#aaa49d;font-size:15px;line-height:1.85;max-width:680px}
    .closing>a{display:flex;width:max-content;gap:35px;align-items:center;margin-top:28px;padding:15px 19px;border:1px solid #e44743;color:#f4f1ec;font-size:10px;font-weight:850;letter-spacing:.15em}
    .closing>a span{color:#e44743;font-size:18px}
    @media(max-width:700px){
      .profile-hero{min-height:720px;padding:80px 23px 115px}
      .profile-hero:after{width:85vw;right:-48vw;top:22%}
      .hero-intro{font-size:14px}
      .hero-foot{padding:17px 22px;font-size:7px}
      .chapter-jump{top:68px}
      .chapter-jump a{gap:7px;padding:16px 10px;font-size:11px}
      .chapter-jump a>span{font-size:8px}
      .section-heading{grid-template-columns:1fr;gap:22px;padding:37px 0 35px}
      .profile-section{padding:65px 22px}
      .chapter summary{grid-template-columns:34px minmax(0,1fr) 30px;gap:9px;padding:20px 0}
      .chapter-detail{padding:0 36px 20px 43px}
      .chapter-title{font-size:16px}
    }
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
  </style>
</BaseLayout>

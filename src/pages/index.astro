---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <main class="landing">
    <section class="hero">
      <div class="hero-photo" role="img" aria-label="Портретна фотографија"></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">ЛИЧНИ САЈТ</p>
        <h1>Јовица <em>Вратница</em></h1>
        <p class="motto">Пишем. Делујем. Повезујем.</p>
        <p class="intro">Моја прича је прича о бунту, слободи, одговорности и људима. Не пристајем на готове одговоре — верујем у разговор, личну иницијативу и дела.</p>
        <p class="choose">Упознај мој свет <span>↓</span></p>
      </div>
      <span class="hero-index">01 <i>/</i> 04</span>
    </section>

    <nav class="main-links" aria-label="Главне странице">
      <a class="link-card" href={import.meta.env.BASE_URL + 'o-meni/'}>
        <span class="number">01 / ЛИЧНА ПРИЧА</span>
        <span class="link-title">О мени</span><span class="arrow">↗</span>
      </a>
      <a class="link-card" href={import.meta.env.BASE_URL + 'moja-borba/'}>
        <span class="number">02 / УВЕРЕЊА</span>
        <span class="link-title">Моја борба</span><span class="arrow">↗</span>
      </a>
      <a class="link-card" href={import.meta.env.BASE_URL + 'junacko-srce/'}>
        <span class="number">03 / ИДЕЈА</span>
        <span class="link-title">Јуначко срце</span><span class="arrow">↗</span>
      </a>
      <a class="link-card" href={import.meta.env.BASE_URL + 'projekti/'}>
        <span class="number">04 / ДЕЛА</span>
        <span class="link-title">Пројекти</span><span class="arrow">↗</span>
      </a>
    </nav>
    <footer>ЗА ЉУДЕ, НЕ ЗА ПРОФИТ.</footer>
  </main>
  <style>
    :global(*){box-sizing:border-box}
    :global(html),:global(body){margin:0;min-height:100%;background:#101010}
    .landing{width:100%;min-height:100svh;color:#e9e7e3;background:#101010;font-family:'Manrope',Arial,sans-serif}
    .hero{position:relative;width:100%;min-height:68svh;display:flex;align-items:center;overflow:hidden;padding:clamp(55px,9vw,120px) clamp(24px,10vw,150px);color:#fff;background:#101010}
    .hero-photo{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=2000&q=88') center 34%/cover}
    .hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,8,8,.94),rgba(8,8,8,.68) 48%,rgba(8,8,8,.18)),linear-gradient(0deg,rgba(8,8,8,.6),transparent 55%)}
    .hero-content{position:relative;z-index:1;width:min(700px,100%)}
    .eyebrow{margin:0 0 22px;color:#e44743;font-size:10px;font-weight:800;letter-spacing:.24em}
    h1{margin:0;font-family:'Manrope',Arial,sans-serif;font-size:clamp(54px,9vw,112px);line-height:.98;font-weight:800;letter-spacing:-.075em}
    h1 em{color:#e44743;font-style:normal}
    .motto{margin:24px 0 14px;font-size:clamp(14px,1.5vw,18px);font-weight:800;letter-spacing:.08em}
    .intro{max-width:590px;margin:0;color:#d0ceca;font-size:clamp(13px,1.3vw,16px);line-height:1.85}
    .choose{margin:30px 0 0;color:#e44743;font-size:10px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}
    .choose span{font-size:17px;margin-left:12px}
    .hero-index{position:absolute;z-index:1;right:clamp(24px,6vw,90px);bottom:28px;color:#aaa;font-size:10px;letter-spacing:.16em}
    .hero-index i{font-style:normal;color:#e44743;padding:0 8px}
    .main-links{width:100%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #343331;border-bottom:1px solid #343331}
    .link-card{min-height:175px;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:27px clamp(17px,3vw,42px);color:#e9e7e3;text-decoration:none;background:#151413;border-right:1px solid #343331;transition:background .2s ease}
    .link-card:last-child{border-right:0}
    .link-card:hover{background:#211f1d}
    .number{color:#999895;font-size:9px;font-weight:800;letter-spacing:.15em}
    .link-title{padding-right:25px;font-family:'Manrope',Arial,sans-serif;font-size:clamp(23px,3vw,38px);line-height:1.05;font-weight:800;letter-spacing:-.05em}
    .arrow{position:absolute;right:clamp(17px,3vw,42px);bottom:25px;color:#e44743;font-size:22px}
    footer{width:100%;margin:0;padding:25px 6vw;color:#777;font-size:9px;font-weight:800;letter-spacing:.2em;text-align:center;background:#101010}
    @media(max-width:760px){
      .hero{min-height:66svh;padding:55px 25px 75px;align-items:flex-end}
      .hero-photo{background-position:58% center}
      .hero-shade{background:linear-gradient(0deg,rgba(8,8,8,.96),rgba(8,8,8,.55) 70%,rgba(8,8,8,.18))}
      h1{font-size:clamp(49px,12vw,76px)}
      .intro{font-size:13px;line-height:1.75}
      .main-links{grid-template-columns:repeat(2,minmax(0,1fr))}
      .link-card{min-height:135px;padding:20px 17px;border-bottom:1px solid #343331}
      .link-card:nth-child(2){border-right:0}
      .link-title{font-size:clamp(24px,6vw,32px)}
      .arrow{right:17px;bottom:18px}
    }
    @media(max-width:380px){.link-card{min-height:125px;padding:17px 13px}.number{font-size:8px}.link-title{font-size:23px}.arrow{right:13px}}
  </style>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <main class="landing">
    <div class="landing-inner">
      <p class="eyebrow">ЛИЧНИ САЈТ</p>
      <h1>Јовица <em>Вратница</em></h1>
      <p class="intro">Изабери где желиш да наставиш.</p>

      <nav class="main-links" aria-label="Главне странице">
        <a class="link-card" href={import.meta.env.BASE_URL + 'o-meni/'}>
          <span class="number">01</span>
          <span class="link-title">О мени</span>
          <span class="arrow">↗</span>
        </a>
        <a class="link-card" href={import.meta.env.BASE_URL + 'moja-borba/'}>
          <span class="number">02</span>
          <span class="link-title">Моја борба</span>
          <span class="arrow">↗</span>
        </a>
        <a class="link-card" href={import.meta.env.BASE_URL + 'junacko-srce/'}>
          <span class="number">03</span>
          <span class="link-title">Јуначко срце</span>
          <span class="arrow">↗</span>
        </a>
        <a class="link-card" href={import.meta.env.BASE_URL + 'projekti/'}>
          <span class="number">04</span>
          <span class="link-title">Пројекти</span>
          <span class="arrow">↗</span>
        </a>
      </nav>

      <footer>ПИШЕМ · ДЕЛУЈЕМ · ПОВЕЗУЈЕМ</footer>
    </div>
  </main>

  <style>
    :global(*) { box-sizing: border-box; }
    :global(html), :global(body) { margin: 0; min-height: 100%; }
    .landing {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 48px 22px;
      color: #292b27;
      background:
        radial-gradient(ellipse at 15% 10%, rgba(206, 196, 174, .25), transparent 38%),
        #f4f2ec;
      font-family: 'Manrope', 'Arial', sans-serif;
    }
    .landing-inner { width: min(760px, 100%); }
    .eyebrow {
      margin: 0 0 14px;
      color: #8b7559;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .22em;
    }
    h1 {
      margin: 0;
      font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
      font-size: clamp(54px, 10vw, 86px);
      line-height: .95;
      font-weight: 800;
      letter-spacing: -.035em;
    }
    h1 em { color: #9a6948; font-style: normal; }
    .intro {
      margin: 17px 0 34px;
      color: #77766f;
      font-size: 14px;
    }
    .main-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 13px;
    }
    .link-card {
      min-height: 128px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 19px 21px;
      color: #292b27;
      text-decoration: none;
      background: rgba(255,255,255,.72);
      border: 1px solid #dedbd2;
      border-radius: 5px;
      transition: background .2s, border-color .2s, transform .2s;
    }
    .link-card:hover {
      background: #fff;
      border-color: #9a6948;
      transform: translateY(-3px);
    }
    .number {
      color: #9a6948;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .12em;
    }
    .link-title {
      padding-right: 28px;
      font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
      font-size: clamp(27px, 4vw, 36px);
      line-height: 1;
      font-weight: 700;
    }
    .arrow {
      position: absolute;
      right: 19px;
      bottom: 18px;
      color: #9a6948;
      font-size: 21px;
    }
    .landing-inner > footer {
      margin-top: 34px;
      color: #99958b;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .16em;
    }
    @media (max-width: 520px) {
      .landing { padding: 34px 18px; }
      .intro { margin-bottom: 25px; }
      .main-links { gap: 10px; }
      .link-card { min-height: 116px; padding: 15px 14px; }
      .link-title { font-size: clamp(23px, 6.5vw, 30px); }
      .arrow { right: 13px; bottom: 13px; }
      .landing-inner > footer { margin-top: 25px; font-size: 9px; }
    }
  </style>
</BaseLayout>

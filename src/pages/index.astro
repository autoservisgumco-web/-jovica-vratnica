---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <main class="landing">
    <section class="hero">
      <div class="hero-photo" role="img" aria-label="Портретна фотографија"></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">ЛИЧНИ САЈТ</p>
        <h1>Јовица <em>Вратница</em></h1>
        <p class="motto">Пишем. Делујем. Повезујем.</p>
        <p class="intro">Моја прича је прича о бунту, слободи, одговорности и људима. Не пристајем на готове одговоре — верујем у разговор, личну иницијативу и дела.</p>
        <p class="choose">Упознај мој свет:</p>
      </div>
    </section>
    <nav class="main-links" aria-label="Главне странице">
      <a class="link-card" href={import.meta.env.BASE_URL + 'o-meni/'}><span class="number">01 / ЛИЧНА ПРИЧА</span><span class="link-title">О мени</span><span class="arrow">↗</span></a>
      <a class="link-card" href={import.meta.env.BASE_URL + 'moja-borba/'}><span class="number">02 / УВЕРЕЊА</span><span class="link-title">Моја борба</span><span class="arrow">↗</span></a>
      <a class="link-card" href={import.meta.env.BASE_URL + 'junacko-srce/'}><span class="number">03 / ИДЕЈА</span><span class="link-title">Јуначко срце</span><span class="arrow">↗</span></a>
      <a class="link-card" href={import.meta.env.BASE_URL + 'projekti/'}><span class="number">04 / ДЕЛА</span><span class="link-title">Пројекти</span><span class="arrow">↗</span></a>
    </nav>
    <footer>ЗА ЉУДЕ, НЕ ЗА ПРОФИТ.</footer>
  </main>
  <style>
    :global(*){box-sizing:border-box}
    :global(html),:global(body){margin:0;min-height:100%;background:#f4f2ec}
    .landing{min-height:100svh;padding:0 22px 30px;color:#292b27;background:#f4f2ec;font-family:'Manrope',Arial,sans-serif}
    .hero{position:relative;min-height:410px;max-width:1100px;margin:0 auto;display:flex;align-items:center;overflow:hidden;padding:62px clamp(24px,7vw,78px);color:#fff;background:#34332f}
    .hero-photo{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1800&q=88') center 34%/cover}
    .hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(17,19,18,.88),rgba(17,19,18,.54) 52%,rgba(17,19,18,.12)),linear-gradient(0deg,rgba(17,19,18,.32),transparent 55%)}
    .hero-content{position:relative;z-index:1;width:min(590px,100%)}
    .eyebrow{margin:0 0 17px;color:#e6c6a5;font-size:10px;font-weight:800;letter-spacing:.22em}
    h1{margin:0;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:clamp(52px,8vw,82px);line-height:.98;font-weight:800;letter-spacing:-.035em}
    h1 em{color:#e6b58f;font-style:normal}
    .motto{margin:18px 0 12px;font-size:15px;font-weight:800;letter-spacing:.08em}
    .intro{max-width:520px;margin:0;color:#e3e0da;font-size:13px;line-height:1.8}
    .choose{margin:21px 0 0;color:#e6c6a5;font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
    .main-links{width:min(900px,100%);margin:22px auto 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
    .link-card{min-height:112px;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:17px 20px;color:#292b27;text-decoration:none;background:#fff;border:1px solid #dedbd2;border-left:4px solid #a77a58;border-radius:4px;transition:background .2s,border-color .2s,transform .2s}
    .link-card:hover{background:#faf7f1;border-color:#a77a58;transform:translateY(-2px)}
    .number{color:#927253;font-size:9px;font-weight:800;letter-spacing:.13em}
    .link-title{padding-right:28px;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:clamp(27px,4vw,34px);line-height:1;font-weight:700}
    .arrow{position:absolute;right:18px;bottom:16px;color:#a77a58;font-size:21px}
    footer{width:min(900px,100%);margin:23px auto 0;color:#918a7e;font-size:9px;font-weight:800;letter-spacing:.18em;text-align:center}
    @media(max-width:520px){
      .landing{padding:0 12px 24px}
      .hero{min-height:430px;padding:42px 23px;align-items:flex-end}
      .hero-photo{background-position:58% center}
      .hero-shade{background:linear-gradient(0deg,rgba(15,17,16,.94),rgba(15,17,16,.5) 68%,rgba(15,17,16,.12))}
      h1{font-size:clamp(50px,14vw,70px)}
      .intro{font-size:12px;line-height:1.7}
      .main-links{gap:9px;margin-top:13px}
      .link-card{min-height:104px;padding:14px 12px}
      .link-title{font-size:clamp(23px,6.4vw,29px)}
      .arrow{right:11px;bottom:12px}
    }
  </style>
</BaseLayout>
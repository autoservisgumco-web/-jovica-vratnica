---
import BaseLayout from '../layouts/BaseLayout.astro';
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout>
  <main class="landing">
    <section class="hero">
      <div class="hero-photo" role="img" aria-label="Портретна фотографија"></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">ЛИЧНИ САЈТ</p>
        <h1>Јовица <em>Вратница</em></h1>
        <p class="identity">Филозоф. Бунтовник. Човек који се води срцем.</p>
        <p class="motto">Пишем. Делујем. Повезујем.</p>
        <div class="home-actions">
          <a class="home-action home-action-primary" href={basePath + 'o-meni/'}>Ко сам ја? <span>↗</span></a>
          <button class="home-action" type="button" onclick="document.getElementById('global-menu').showModal()">Упознај мој свет <span>＋</span></button>
        </div>
      </div>
      <span class="hero-index">ПИШЕМ <i>·</i> ДЕЛУЈЕМ <i>·</i> ПОВЕЗУЈЕМ</span>
    </section>

    
    <footer>ЗА ЉУДЕ, НЕ ЗА ПРОФИТ.</footer>
  </main>
  <style>

    .home-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}
    .home-action{min-height:44px;display:inline-flex;align-items:center;justify-content:space-between;gap:26px;padding:0 17px;border:1px solid rgba(255,255,255,.42);border-radius:3px;background:rgba(15,15,15,.38);color:#fff;font:750 11px 'Manrope',sans-serif;letter-spacing:.04em;cursor:pointer;backdrop-filter:blur(8px)}
    .home-action span{color:#e44743;font-size:16px}
    .home-action-primary{background:#e44743;border-color:#e44743}
    .home-action-primary span{color:#fff}
    .home-action:hover{border-color:#e44743;background:rgba(228,71,67,.15)}
    .home-action-primary:hover{background:#c93a36}
    @media(max-width:600px){.home-actions{gap:8px}.home-action{min-height:42px;padding:0 13px;gap:15px;font-size:10px}}
    :global(*){box-sizing:border-box}
    :global(html),:global(body){margin:0;min-height:100%;background:#101010}
    .landing{width:100%;min-height:100svh;color:#e9e7e3;background:#101010;font-family:'Manrope',Arial,sans-serif}
    .hero{position:relative;width:100%;min-height:100svh;min-height:100dvh;display:flex;align-items:center;overflow:hidden;padding:clamp(48px,7vw,90px) clamp(24px,10vw,150px);color:#fff;background:radial-gradient(ellipse at 78% 22%,rgba(228,71,67,.2),transparent 42%),linear-gradient(135deg,#252321 0%,#141312 58%,#101010 100%)}
    .hero-photo{position:absolute;inset:0;background:url('/-jovica-vratnica/images/jovica-uvod.jpg') center 34%/cover;opacity:.55}
    .hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,8,8,.94),rgba(8,8,8,.72) 52%,rgba(8,8,8,.3)),linear-gradient(0deg,rgba(8,8,8,.72),transparent 65%),radial-gradient(ellipse at 78% 20%,rgba(228,71,67,.16),transparent 48%)}
    .hero-content{position:relative;z-index:1;width:min(850px,100%)}
    .eyebrow{margin:0 0 18px;color:#e44743;font-size:10px;font-weight:800;letter-spacing:.24em}
    h1{margin:0;font-family:'Manrope',Arial,sans-serif;font-size:clamp(52px,8vw,100px);line-height:.98;font-weight:800;letter-spacing:-.075em}
    h1 em{color:#e44743;font-style:normal}
    .identity{margin:19px 0 0;color:#f0eeeb;font-size:clamp(15px,1.8vw,21px);font-weight:650;letter-spacing:.01em}
    .motto{margin:12px 0 28px;color:#c9c5bf;font-size:clamp(12px,1.3vw,15px);font-weight:800;letter-spacing:.12em}
    .pathways{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;max-width:760px}
    .path{position:relative;min-height:158px;display:flex;flex-direction:column;justify-content:center;gap:9px;padding:22px 52px 22px 23px;border:1px solid rgba(255,255,255,.3);border-radius:5px;color:#fff;text-decoration:none;background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(255,255,255,.035));backdrop-filter:blur(5px);transition:transform .2s ease,border-color .2s ease,background .2s ease}
    .path:hover{transform:translateY(-3px);border-color:#e44743;background:rgba(228,71,67,.15)}
    .path-for-you{border-color:rgba(228,71,67,.85);background:linear-gradient(135deg,rgba(228,71,67,.88),rgba(137,40,38,.72))}
    .path-for-you:hover{background:linear-gradient(135deg,rgba(228,71,67,.98),rgba(137,40,38,.88))}
    .path-kicker{font-size:9px;font-weight:800;letter-spacing:.17em;color:#e9aaa7}
    .path-title{max-width:330px;font-size:clamp(21px,2.7vw,31px);font-weight:850;line-height:1.08;letter-spacing:-.045em}
    .path-description{max-width:340px;color:#e0ddda;font-size:12px;line-height:1.55}
    .path-arrow{position:absolute;right:20px;top:20px;color:#fff;font-size:22px}
    .supporting{margin:17px 0 0;color:#aaa6a0;font-size:11px;letter-spacing:.025em}
    .world-trigger{margin-top:19px;padding:10px 0;border:0;border-bottom:1px solid rgba(228,71,67,.7);color:#f0eeeb;background:transparent;font:800 10px 'Manrope',Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;cursor:pointer}
    .world-trigger span{margin-left:10px;color:#e44743;font-size:16px}
    .world-menu{position:fixed;inset:auto 0 0;margin:0 auto 0;width:min(680px,100%);max-width:none;max-height:min(82dvh,720px);padding:28px clamp(20px,5vw,38px) 34px;border:1px solid #48413d;border-bottom:0;border-radius:18px 18px 0 0;color:#eeeae5;background:linear-gradient(145deg,#292522,#151413 75%);box-shadow:0 -18px 70px rgba(0,0,0,.45)}
    .world-menu[open]{animation:sheet-in .25s ease-out}
    .world-menu::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(4px)}
    @keyframes sheet-in{from{transform:translateY(35px);opacity:.6}to{transform:translateY(0);opacity:1}}
    .menu-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:22px}
    .menu-head p{margin:0 0 8px;color:#e44743;font-size:9px;font-weight:800;letter-spacing:.2em}
    .menu-head h2{margin:0;font-size:clamp(22px,4vw,30px);line-height:1.15;letter-spacing:-.04em}
    .menu-close{width:38px;height:38px;flex:0 0 38px;border:1px solid #625b55;border-radius:50%;color:#fff;background:transparent;font-size:25px;cursor:pointer}
    .menu-links{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .menu-links a{position:relative;display:grid;grid-template-columns:28px 1fr 20px;grid-template-rows:auto auto;column-gap:10px;align-items:center;min-height:88px;padding:15px;border:1px solid #49433e;border-radius:5px;color:#f1eee9;text-decoration:none;background:rgba(255,255,255,.035)}
    .menu-links a:hover{border-color:#e44743;background:rgba(228,71,67,.1)}
    .menu-links a>span{grid-row:1/3;color:#e44743;font-size:10px;font-weight:800}
    .menu-links strong{font-size:16px}
    .menu-links i{grid-column:2;color:#aaa39b;font-size:10px;font-style:normal}
    .menu-links b{grid-column:3;grid-row:1/3;color:#e44743;font-size:19px}
    .hero-index{position:absolute;z-index:1;right:clamp(24px,6vw,90px);bottom:25px;color:#aaa;font-size:9px;letter-spacing:.16em}
    .hero-index i{font-style:normal;color:#e44743;padding:0 5px}
    .secondary-links{display:flex;align-items:center;justify-content:center;gap:30px;flex-wrap:wrap;padding:23px 20px;border-top:1px solid #343331;border-bottom:1px solid #343331;background:#151413}
    .secondary-links span{color:#85817b;font-size:9px;font-weight:800;letter-spacing:.15em}
    .secondary-links a{color:#e9e7e3;text-decoration:none;font-size:12px;font-weight:700}
    .secondary-links a:hover{color:#e44743}
    .secondary-links b{margin-left:5px;color:#e44743}
    footer{width:100%;margin:0;padding:23px 6vw;color:#777;font-size:9px;font-weight:800;letter-spacing:.2em;text-align:center;background:#101010}
    @media(max-width:760px){
      .hero{min-height:100svh;min-height:100dvh;padding:52px 22px 66px;align-items:center}
      .hero-photo{background-position:58% center;opacity:.42}
      .hero-shade{background:linear-gradient(0deg,rgba(8,8,8,.97),rgba(8,8,8,.76) 68%,rgba(8,8,8,.42)),radial-gradient(ellipse at 80% 15%,rgba(228,71,67,.18),transparent 48%)}
      h1{font-size:clamp(47px,11.5vw,72px)}
      .identity{font-size:15px;line-height:1.45}
      .motto{margin:10px 0 23px;font-size:11px}
      .pathways{grid-template-columns:1fr;gap:10px}
      .path{min-height:125px;padding:18px 48px 18px 18px}
      .path-title{font-size:clamp(22px,6vw,29px)}
      .path-description{font-size:11px}
      .supporting{max-width:330px;font-size:10px;line-height:1.5}
      .world-trigger{margin-top:14px;font-size:9px}
      .world-menu{padding:23px 18px 28px}
      .menu-links{grid-template-columns:1fr}
      .menu-links a{min-height:70px;padding:12px 14px}
      .menu-links strong{font-size:15px}
      .menu-head h2{font-size:23px}
      .hero-index{right:22px;bottom:17px;font-size:8px}
      .secondary-links{gap:14px 22px;padding:20px 14px}
      .secondary-links span{width:100%;text-align:center}
    }
    @media(max-height:760px) and (min-width:761px){
      .hero{padding-top:35px;padding-bottom:45px}
      .path{min-height:135px}
      .motto{margin-bottom:18px}
    }
  </style>
</BaseLayout>

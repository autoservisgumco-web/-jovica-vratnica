---
import BaseLayout from '../layouts/BaseLayout.astro';

const {
  pageTitle,
  description,
  eyebrow,
  title,
  subtitle,
  intro,
  visualQuote,
  visualLabel,
  cards
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={pageTitle} description={description}>
  <main class="story-hub">
    <div class="hub-progress" aria-hidden="true"><span id="hub-progress-bar"></span></div>

    <section class="hub-screen hub-hero" aria-labelledby="hub-title">
      <div class="hub-content">
        <p class="hub-eyebrow"><span></span>{eyebrow}</p>
        <h1 id="hub-title">{title}</h1>
        {subtitle && <p class="hub-subtitle">{subtitle}</p>}
        <p class="hub-intro">{intro}</p>
        <blockquote class="hub-quote">{visualQuote}</blockquote>
        <p class="hub-visual-label">{visualLabel}</p>
        <a class="hub-scroll-cue" href="#hub-stories">НАСТАВИ ДАЉЕ <span>↓</span></a>
      </div>
      <span class="hub-chapter">01 <i>/</i> ПРИЧА</span>
    </section>

    <section class="hub-screen hub-stories" id="hub-stories" aria-labelledby="stories-title">
      <div class="hub-content hub-stories-content">
        <div class="hub-section-heading">
          <div>
            <p class="hub-eyebrow"><span></span>ИСТРАЖИ ДАЉЕ</p>
            <h2 id="stories-title">УПОЗНАЈ ДЕЛОВЕ <em>МОЈЕ ПРИЧЕ.</em></h2>
          </div>
          <p>Изабери тему и настави даље. Свака целина отвара своју причу.</p>
        </div>

        <div class="hub-card-grid">
          {cards.map((card, index) => (
            <a class="hub-card" href={base + card.href}>
              <span class="hub-card-number">{String(index + 1).padStart(2, '0')}</span>
              <div class="hub-card-copy">
                <p>{card.kicker}</p>
                <h3>{card.title}</h3>
                <span class="hub-card-description">{card.description}</span>
              </div>
              <span class="hub-card-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="hub-footer">
          <span>ЈОВИЦА ВРАТНИЦА</span>
          <span>ПИШЕМ. ДЕЛУЈЕМ. ПОВЕЗУЈЕМ.</span>
          <a href={base}>← ПОЧЕТНА</a>
        </div>
      </div>
      <span class="hub-chapter">02 <i>/</i> НАСТАВАК</span>
    </section>
  </main>

  <script>
    const bar = document.getElementById('hub-progress-bar');
    const updateHubProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? (window.scrollY / max) * 100 : 0;
      if (bar) bar.style.width = progress + '%';
    };
    window.addEventListener('scroll', updateHubProgress, { passive: true });
    window.addEventListener('resize', updateHubProgress);
    updateHubProgress();
  </script>

  <style>
    :global(html) {
      scroll-behavior: smooth;
      scroll-snap-type: y mandatory;
      background: #101114;
    }
    :global(body) { background: #101114; }

    .story-hub {
      --hub-bg: #101114;
      --hub-panel: #17191e;
      --hub-text: #f3f1ed;
      --hub-muted: #aaa9a5;
      --hub-red: #e3424d;
      min-height: 100svh;
      color: var(--hub-text);
      background:
        radial-gradient(ellipse at 80% 12%, #e3424d1c, transparent 34rem),
        var(--hub-bg);
    }
    .hub-progress {
      position: fixed;
      z-index: 40;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      pointer-events: none;
    }
    .hub-progress span {
      display: block;
      width: 0;
      height: 100%;
      background: var(--hub-red);
      transition: width .12s linear;
    }
    .hub-screen {
      min-height: 100svh;
      min-height: 100dvh;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 105px max(24px, calc((100vw - 900px) / 2)) 88px;
      overflow: hidden;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      border-bottom: 1px solid #ffffff0a;
      isolation: isolate;
    }
    .hub-screen:nth-of-type(even) { background: #ffffff06; }
    .hub-screen::after {
      content: '';
      position: absolute;
      z-index: -1;
      width: min(70vw, 540px);
      aspect-ratio: 1;
      right: -24%;
      bottom: -42%;
      border: 1px solid #e3424d20;
      border-radius: 50%;
      box-shadow: 0 0 0 45px #e3424d08, 0 0 0 90px #e3424d05;
      pointer-events: none;
    }
    .hub-content {
      width: min(100%, 760px);
      margin: auto;
    }
    .hub-eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 22px;
      color: var(--hub-red);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .2em;
    }
    .hub-eyebrow > span {
      width: 27px;
      height: 1px;
      background: var(--hub-red);
    }
    .hub-hero h1,
    .hub-section-heading h2 {
      max-width: 820px;
      margin: 0 0 24px;
      color: var(--hub-text);
      font: 850 clamp(42px, 7.4vw, 82px)/1.01 Manrope, sans-serif;
      letter-spacing: -.065em;
      text-transform: uppercase;
    }
    .hub-subtitle {
      max-width: 700px;
      margin: 0 0 16px;
      color: var(--hub-text);
      font: 750 clamp(19px, 2.6vw, 25px)/1.4 Manrope, sans-serif;
      letter-spacing: -.03em;
    }
    .hub-intro {
      max-width: 700px;
      margin: 0;
      color: #d1cfcb;
      font: 400 clamp(15px, 1.7vw, 18px)/1.75 Manrope, sans-serif;
    }
    .hub-quote {
      max-width: 700px;
      margin: 27px 0 0;
      padding: 5px 0 5px 20px;
      border-left: 2px solid var(--hub-red);
      color: var(--hub-text);
      font: 750 clamp(21px, 3vw, 29px)/1.35 Manrope, sans-serif;
      letter-spacing: -.035em;
    }
    .hub-visual-label {
      margin: 15px 0 0 22px;
      color: #858487;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .16em;
    }
    .hub-scroll-cue {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin-top: 31px;
      color: var(--hub-muted);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .18em;
    }
    .hub-scroll-cue span { color: var(--hub-red); font-size: 19px; }
    .hub-chapter {
      position: absolute;
      left: max(24px, calc((100vw - 900px) / 2));
      bottom: 27px;
      color: #858487;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .16em;
    }
    .hub-chapter i { padding: 0 7px; color: var(--hub-red); font-style: normal; }

    .hub-stories-content {
      width: min(100%, 900px);
    }
    .hub-section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 35px;
      margin-bottom: 30px;
    }
    .hub-section-heading h2 {
      max-width: 600px;
      margin: 0;
      font-size: clamp(32px, 5vw, 54px);
    }
    .hub-section-heading h2 em { color: var(--hub-red); font-style: normal; }
    .hub-section-heading > p {
      max-width: 280px;
      margin: 0 0 3px;
      color: var(--hub-muted);
      font: 400 12px/1.7 Manrope, sans-serif;
    }
    .hub-card-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .hub-card {
      min-height: 165px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 19px 21px;
      border: 1px solid #ffffff20;
      background: #17191e;
      color: var(--hub-text);
      transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }
    .hub-card:hover {
      transform: translateY(-3px);
      border-color: var(--hub-red);
      background: #1d1f25;
    }
    .hub-card-number {
      color: var(--hub-red);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .14em;
    }
    .hub-card-copy { padding: 14px 25px 0 0; }
    .hub-card-copy > p {
      margin: 0 0 7px;
      color: #999894;
      font-size: 8px;
      font-weight: 850;
      letter-spacing: .15em;
    }
    .hub-card h3 {
      margin: 0 0 7px;
      color: var(--hub-text);
      font: 750 18px/1.25 Manrope, sans-serif;
      letter-spacing: -.035em;
    }
    .hub-card-description {
      display: block;
      color: #b5b3af;
      font: 400 11px/1.55 Manrope, sans-serif;
    }
    .hub-card-arrow {
      position: absolute;
      top: 15px;
      right: 18px;
      color: var(--hub-red);
      font-size: 19px;
    }
    .hub-footer {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-top: 24px;
      padding-top: 15px;
      border-top: 1px solid #ffffff20;
      color: #858487;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: .13em;
    }
    .hub-footer a { color: var(--hub-red); }

    @media (max-width: 700px) {
      .hub-screen { padding: 92px 24px 82px; }
      .hub-hero h1 { font-size: clamp(39px, 10vw, 57px); line-height: 1.03; }
      .hub-subtitle { font-size: 18px; }
      .hub-intro { font-size: 15px; line-height: 1.68; }
      .hub-quote { margin-top: 21px; padding-left: 16px; font-size: 21px; }
      .hub-section-heading {
        display: block;
        margin-bottom: 22px;
      }
      .hub-section-heading h2 { margin-bottom: 12px; font-size: clamp(30px, 8vw, 42px); }
      .hub-section-heading > p { max-width: 100%; font-size: 11px; }
      .hub-card-grid { gap: 9px; }
      .hub-card { min-height: 150px; padding: 15px 13px; }
      .hub-card-copy { padding: 13px 15px 0 0; }
      .hub-card h3 { font-size: 15px; }
      .hub-card-description { font-size: 10px; line-height: 1.45; }
      .hub-card-arrow { top: 11px; right: 12px; }
      .hub-chapter { left: 24px; bottom: 22px; font-size: 8px; }
      .hub-footer { flex-wrap: wrap; font-size: 7px; }
    }
    @media (max-width: 380px) {
      .hub-card-grid { grid-template-columns: 1fr; }
      .hub-card { min-height: 125px; }
      .hub-stories { padding-top: 85px; }
    }
    @media (max-height: 720px) and (min-width: 701px) {
      .hub-screen { padding-top: 78px; padding-bottom: 68px; }
      .hub-hero h1 { font-size: clamp(37px, 5.5vw, 62px); margin-bottom: 16px; }
      .hub-intro { font-size: 14px; line-height: 1.55; }
      .hub-quote { margin-top: 17px; font-size: 22px; }
      .hub-card { min-height: 135px; }
    }
    @media (prefers-reduced-motion: reduce) {
      :global(html) { scroll-behavior: auto; }
      .hub-progress span, .hub-card { transition: none; }
    }
  </style>
</BaseLayout>
